# --- Database (shared Postgres with the Rails service) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kobo

# --- HTTP ---
PORT=3000
# Bearer token Rails must send to internal endpoints (/api/v1/split, /sweeps/*, /pfa/*, ...). Empty = open (dev only).
SERVICE_TOKEN=
# Optional token the telco must send as ?token= on /api/v1/ussd and /api/v1/sms/inbound. Empty = open (dev only).
WEBHOOK_TOKEN=

# --- Sweep executor (Rails owns the bank debit) ---
# mock = in-memory executor for local dev/demo, http = call the Rails executor endpoints
EXECUTOR_MODE=mock
RAILS_BASE_URL=http://localhost:3001
RAILS_SERVICE_TOKEN=

# --- Nightly scheduler (Africa/Lagos) ---
SCHEDULER_ENABLED=true
SWEEP_CRON=0 23 * * *
SWEEP_RETRY_CRON=30 23 * * *
SWEEP_BATCH_CONCURRENCY=10
SWEEP_IN_RUN_TRIES=3
SWEEP_MAX_ATTEMPTS=6
SWEEP_BACKOFF_BASE_MS=1000

# --- SMS ---
# console = log to stdout (dev), africastalking = real delivery
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_DISPATCH_INTERVAL_MS=5000
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BASE_MS=30000

# PIN security (emergency withdrawals and PIN changes)
PIN_PEPPER=
PIN_MAX_ATTEMPTS=3
PIN_LOCK_MINUTES=30
WITHDRAWAL_PIN_REQUIRED=true

# Smart Rate
SMART_RATE_EXPIRY_HOURS=72
SMART_RATE_DECLINE_COOLDOWN_DAYS=14

# Sweep Guard: how many days after the sweep date a held sweep can still be released
GUARD_RELEASE_WINDOW_DAYS=3

# IVR voice (Africa's Talking Voice)
VOICE_PROVIDER=console
AT_VOICE_NUMBER=
VOICE_MAX_ATTEMPTS=3
VOICE_RETRY_BASE_MS=60000
VOICE_CALL_TIMEOUT_MS=300000
VOICE_DISPATCH_INTERVAL_MS=10000

# Dev / demo
# Balance (naira) the mock executor reports for any account. 0 = every sweep skips for low buffer.
MOCK_DEFAULT_BALANCE_NAIRA=500000
# Simple threshold guard: hold any night above this many naira (0 = off). Use 1000000 for the demo.
GUARD_HOLD_ABOVE_NAIRA=0

# Logging and production guard
LOG_LEVEL=info
# NODE_ENV=production refuses to start unless SERVICE_TOKEN, WEBHOOK_TOKEN, PIN_PEPPER are set and EXECUTOR_MODE=http

# AI Sweep Guard service (leave GUARD_URL empty to use GUARD_HOLD_ABOVE_NAIRA or allow-all)
GUARD_URL=
GUARD_TOKEN=
GUARD_TIMEOUT_MS=3000
GUARD_FAIL_CLOSED=false
