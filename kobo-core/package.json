{
  "name": "kobo-core",
  "version": "0.1.0",
  "private": true,
  "description": "Kobo Kobo core backend: split engine, double-entry ledger, nightly sweep scheduler, PFA simulator, USSD/SMS gateway",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:sweep": "tsx scripts/demo-sweep.ts",
    "demo:ussd": "tsx scripts/demo-channel.ts ussd",
    "demo:sms": "tsx scripts/demo-channel.ts sms"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
